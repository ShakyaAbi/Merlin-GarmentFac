# Copy this file to mysql-ready/mysql.env before starting the MySQL container
MYSQL_DATABASE=merlin_mysql
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=merlin
MYSQL_PASSWORD=change_me_user

# Future app connection string if you switch the API later
DATABASE_URL=mysql://merlin:change_me_user@127.0.0.1:3306/merlin_mysql

