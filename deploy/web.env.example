# Copy this to deploy/web.env and set the public API base URL for production
# This file will be copied to apps/web/.env.production before building the frontend.
# The deploy nginx proxies this same-origin API path to the API container.
VITE_API_BASE_URL=/api/v1
# Optional: if you serve MERLIN from a subpath, set the base path here.
# Example for a host proxy under /merlin/: VITE_BASE_URL=/merlin/
VITE_BASE_URL=/
