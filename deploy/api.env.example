# Copy this file to deploy/api.env and fill values before first deploy
NODE_ENV=production
PORT=4000
APP_URL=http://YOUR_VPS_IP
CORS_ORIGINS=http://YOUR_VPS_IP
MYSQL_DATABASE=merlin
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
MYSQL_USER=merlin
MYSQL_PASSWORD=replace_with_a_long_random_app_password
DATABASE_URL=mysql://merlin:replace_with_a_long_random_app_password@mysql:3306/merlin
JWT_SECRET=replace_with_a_long_random_jwt_secret
ML_SERVICE_URL=http://ml:8000
# Optional Google OAuth configuration for social sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTH_REDIRECT_URI=http://YOUR_VPS_IP/api/v1/auth/google/callback
# Optionals
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Reminder scheduler settings
# Set to false to disable automatic reminder email scheduling
REMINDER_SCHEDULER_ENABLED=true
# Cron expression for reminder job (default: daily at 08:00)
REMINDER_CRON=0 8 * * *
# When true, email sending is logged only (dry run)
EMAIL_DRY_RUN=false
